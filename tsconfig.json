{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",  /* トランスパイル対象のフォルダ */
    "outDir": "./dist",  /* トランスパイル後の.jsファイルの出力先フォルダ */
    "noEmitOnError": true,   /* 型エラーを1つでも検知したら.jsファイルを出力しないようにする。 */

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": [],
    // For nodejs:
    // 
    // "lib": ["esnext"],  
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    /*  ↓ JavaScriptファイルのソースマップ 。ブラウザでデバッグする時など、
          元のTypeScriptのどのコードが対応しているか分かるようになる。 */
    // "sourceMap": true,
    /*  ↓ 型定義ファイル。他のプロジェクトやJavaScriptから
          型情報（TypeScriptで書いた型）を参照できるようになる。 */
    // "declaration": true,
    /*  ↓ 型定義ファイルのソースマップ。.d.tsファイルの元がどこか追跡でき、デバッグなどで便利 */
    // "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  }
}
